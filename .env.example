# ---------------------------------------------------------------------------
# Project Hub configuration. Copy to .env for local development.
# Every service validates its configuration at startup and refuses to start
# when a required value is missing or malformed.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# Public URL of the web application (used in links, e-mails and CSRF origin checks)
APP_URL=http://localhost:3100
# Base URL of customer review links (the web app serves /r/<token>)
REVIEW_BASE_URL=http://localhost:3100/r

# API service
API_PORT=4000
# Where the web server reaches the API (server-side rewrites)
API_INTERNAL_URL=http://127.0.0.1:4000

# Preview gateway: every preview gets <slug>.<PREVIEW_BASE_DOMAIN>
# *.localhost resolves to 127.0.0.1 in browsers, so no DNS setup is needed locally.
PREVIEW_PORT=4100
PREVIEW_BASE_DOMAIN=preview.localhost
PREVIEW_PUBLIC_URL_TEMPLATE=http://{slug}.preview.localhost:4100
# Ports used by process-based previews (apps started with start.command)
PREVIEW_PORT_RANGE=41000-41999

# PostgreSQL 18+ (pnpm db:start runs a local server matching this URL)
DATABASE_URL=postgres://projecthub:projecthub-dev@127.0.0.1:54329/projecthub
TEST_DATABASE_URL=postgres://projecthub:projecthub-dev@127.0.0.1:54329/projecthub_test

# Repositories, artifacts, build workspaces, logs and backups
STORAGE_DIR=./.data/storage

# 32 random bytes, base64. Encrypts secrets, deploy credentials and review tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Session cookie
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Builds: "process" runs commands in an isolated workspace directory on the worker host.
BUILD_CONCURRENCY=1
BUILD_TIMEOUT_MINUTES=20

# Deployment: extra server directories the "local" adapter may publish to (comma separated).
DEPLOY_LOCAL_ROOTS=
# pg_dump used for pre-deployment database backups of managed projects
PG_DUMP_BINARY=pg_dump

# AI (optional). Leave empty to run without AI features; the UI explains how to enable them.
# Provider/model can also be chosen in Admin > AI Control Center; keys are only read from here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Dependency vulnerability database (OSV.dev). Empty disables online dependency scanning.
OSV_API_URL=https://api.osv.dev

# Browser automation for screenshots and responsive tests (requires: pnpm exec playwright install chromium)
BROWSER_AUTOMATION=true

# E-mail (optional). Without SMTP, invitation/reset links are shown to the admin instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Project Hub <noreply@example.com>
