# Copy to deploy/.env on the server and fill in. Never commit the filled-in file.
# Generate secrets: see deploy/README.md → "Generate secrets".

# Public host name of Project Hub; previews are served from *.preview.<PH_DOMAIN>.
PH_DOMAIN=hub.example.com
# PH_DOMAIN with dots escaped, used in the preview router regex.
PH_DOMAIN_REGEX=hub\.example\.com

POSTGRES_PASSWORD=change-me
# 32 random bytes, base64. Encrypts project secrets, deployment credentials and review links: back it up.
APP_ENCRYPTION_KEY=change-me

# Let's Encrypt: account e-mail and the DNS provider for the wildcard preview certificate (credentials in .env.dns).
ACME_EMAIL=admin@example.com
ACME_DNS_PROVIDER=cloudflare

# Local AI (runs in the ollama service; no external AI provider is required).
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
OLLAMA_CONTEXT_TOKENS=16384
# Optional cloud providers stay disabled while empty.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Builds and previews.
BUILD_CONCURRENCY=1
BUILD_TIMEOUT_MINUTES=20
PREVIEW_PORT_RANGE=41000-41999
# Host directories (bind-mounted into worker/api) that the "local folder" deployment target may write to.
DEPLOY_LOCAL_ROOTS=

# Vulnerability database for dependency scans; leave the default or point at an internal OSV mirror.
OSV_API_URL=https://api.osv.dev

# Outgoing e-mail (invitations, notifications). Empty SMTP_HOST disables e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Project Hub <noreply@hub.example.com>

LOG_LEVEL=info
SESSION_TTL_HOURS=12
