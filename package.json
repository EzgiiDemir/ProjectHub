{
  "name": "project-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm run build:server && pnpm --filter @projecthub/web run build",
    "build:server": "tsc -b tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "db:start": "node scripts/dev-db.mjs",
    "db:migrate": "node packages/core/dist/cli/migrate.js",
    "db:generate": "pnpm --filter @projecthub/database run generate",
    "admin:create": "node packages/core/dist/cli/create-admin.js",
    "typecheck": "tsc -b tsconfig.json && pnpm --filter @projecthub/web run typecheck",
    "test": "pnpm run build:server && vitest run",
    "test:e2e": "pnpm --filter @projecthub/web exec playwright test",
    "start:api": "node apps/api/dist/main.js",
    "start:worker": "node apps/worker/dist/main.js",
    "start:web": "pnpm --filter @projecthub/web run start"
  },
  "devDependencies": {
    "@projecthub/contracts": "workspace:*",
    "@projecthub/core": "workspace:*",
    "@projecthub/database": "workspace:*",
    "@types/node": "^26.6.4",
    "drizzle-orm": "^0.45.3",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
